<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>DIVA</title>

    <link rel="stylesheet" href="/css/style.css" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/css/bootstrap.min.css" />
    
    <!-- Prosm.js : syntax highlight (used by the query) -->
    <link href="https://cdn.jsdelivr.net/npm/prismjs@1/themes/prism.css" rel="stylesheet" />
    <!-- Prism.js core -->
    <script src="https://cdn.jsdelivr.net/npm/prismjs@1/prism.min.js"></script>
    <!-- Prism Turtle (dependency of SPARQL) -->
    <script src="https://cdn.jsdelivr.net/npm/prismjs@1.29.0/components/prism-turtle.min.js"></script>
    <!-- SPARQL language support -->
    <script src="https://cdn.jsdelivr.net/npm/prismjs@1/components/prism-sparql.min.js"></script>
    
    
    <script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>

    <script src="https://cdnjs.cloudflare.com/ajax/libs/d3/5.16.0/d3.min.js" integrity="sha512-FHsFVKQ/T1KWJDGSbrUhTJyS1ph3eRrxI228ND0EGaEp6v4a/vGwPWd3Dtd/+9cI7ccofZvl/wulICEurHN1pg==" crossorigin="anonymous" referrerpolicy="no-referrer"></script>
    
    <script type="module" src="/vis-muvin.js"></script>
    <script src="/js/utils.js"></script>
    <script src="/js/table-view.js"></script>
    <script src="/js/bar-chart.js"></script>
    <script src="/js/demo.js"></script>
    
</head>
<body>
    
    <div class="container py-4" style="padding-bottom: 0 !important;">

        <!-- Header -->
        <header class="mb-4 text-center" style="margin-bottom: 0 !important;">
          <h1 class="display-5">DIVA Visualization</h1>
          <p class="lead text-muted">
            Visualization of analytical provenance data (i.e. exploration processes of users while exploring data within a visualization tool).
          </p>
        </header>
      
        <!-- Question Dropdown and Button in Flex Row -->
        <div class="d-flex align-items-end gap-3 mb-4" style="margin-bottom: 0 !important;">
          <div class="flex-grow-1">
            <label for="competency-questions" class="form-label fw-semibold">Competency Questions</label>
            <select id="competency-questions" class="form-select">
              <option value="" selected disabled>Select a competency question</option>
            </select>
          </div>
          <div>
            <button class="btn btn-outline-secondary" id="clear-cache">Clear Cache</button>
          </div>
        </div>
      
    </div>
      
    
    <div class="container-fluid my-4">

        <!-- Single-Level Tabs Navigation -->
        <ul class="nav nav-tabs" id="mainTabs" role="tablist">
          <li class="nav-item" role="presentation">
            <button class="nav-link active" id="sparql-tab" data-bs-toggle="tab" data-bs-target="#sparql" type="button" role="tab">SPARQL Query</button>
          </li>
          <li class="nav-item" role="presentation">
            <button class="nav-link" id="results-tab" data-bs-toggle="tab" data-bs-target="#results" type="button" role="tab">SPARQL Results</button>
          </li>
          <li class="nav-item" role="presentation">
            <button class="nav-link" id="muvin-tab" data-bs-toggle="tab" data-bs-target="#muvin" type="button" role="tab">Muvin</button>
          </li>
          <li class="nav-item" role="presentation">
            <button class="nav-link" id="barchart-tab" data-bs-toggle="tab" data-bs-target="#barchart" type="button" role="tab">Bar Chart</button>
          </li>
        </ul>
      
        <!-- Tabs Content -->
        <div class="tab-content mt-3" id="mainTabsContent">
      
          <!-- SPARQL Query Tab -->
          <div class="tab-pane fade show active" id="sparql" role="tabpanel">
            <pre class="query-box"><code class="language-sparql"></code></pre>
          </div>
      
          <!-- SPARQL Results Tab -->
          <div class="tab-pane fade" id="results" role="tabpanel">
            <div class="results-box">
              <div class="table-container">
                <table id="results-table" class="results-table">
                  <thead></thead>
                  <tbody></tbody>
                </table>
              </div>
              <div id="pagination" class="pagination"></div>
              <p id="no-results" style="display:none;">No results to display.</p>
            </div>
          </div>
      
          <!-- Muvin Tab -->
          <div class="tab-pane fade" id="muvin" role="tabpanel">
            <div class="vis-container" id="muvin-container" style="height: 1000px; width: 100%;">
              <vis-muvin id="vis-muvin" width="100%" height="100%"></vis-muvin>
            </div>
            <div id="muvin-message" class="error-message"></div>
          </div>
      
          <!-- Bar Chart Tab -->
          <div class="tab-pane fade" id="barchart" role="tabpanel">
            <div class="vis-container" id="barchart-container" style="height: 600px; width: 100%;">
              <vis-barchart id="bar-chart" width="100%" height="100%"></vis-barchart>
            </div>
            <div class="error-message"  id="barchart-message"></div>
          </div>
      
        </div>
      </div>
      
      <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
    
</body>


<script>
  document.addEventListener("DOMContentLoaded", async () => new DIVADemo());
</script>

</html>
